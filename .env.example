# ── ADB / Local Device ─────────────────────────────────────────────────
# Run `adb devices` to find the serial of your connected Android device.
# Leave empty to use the sole connected device (adb default).
ADB_DEVICE_SERIAL=
ADB_PATH=adb

# ── Appium UI Observation (Optional Fast UI Hierarchy) ─────────────────
# Set to true to use a running Appium UiAutomator2 server for fast (<200ms) UI dumps.
# Falls back automatically to ADB if Appium is offline or disabled.
USE_APPIUM=true
APPIUM_URL=http://127.0.0.1:4723

# ── TypeSafe AI ────────────────────────────────────────────────────────
# Create a TypeSafe key at https://console.typesafe.ai
TYPESAFE_API_KEY=sk-or-v1-key
TYPESAFE_MODEL=inception/mercury-decide:free
TYPESAFE_DEFAULT_MODEL=inception/mercury-decide:free

# only accepts noul questions - respan/span-01-lite:free
# TYPESAFE_DEFAULT_MODEL=respan/span-01-lite:free

TYPESAFE_BASE_URL=https://openrouter.ai/api

# ── Text Input ─────────────────────────────────────────────────────────
# Faster input acknowledgements with exact local read-back before the next action.
# Set to 'committed' to retain the server-side completion wait for all text input.
TEXT_COMPLETION_MODE=accepted

# ── Logging ────────────────────────────────────────────────────────────
# Verbosity level for autonomous runs: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Target for logs: leave empty to log to console (default).
# Set to a file path (e.g. backend.log or logs/backend.log) to log to that file instead.
LOG_FILE=
# Set to true to output to BOTH logfile and console when LOG_FILE is set (default: false).
LOG_TO_CONSOLE=false

# ── Ports ──────────────────────────────────────────────────────────────
# The studio (Next.js) binds to localhost only.
STUDIO_PORT=3040
# The FastAPI backend port (configured to 8005 to avoid collision with ws-scrcpy on 8000).
FASTAPI_PORT=8005

# ── Backend URL (for Next.js proxy) ───────────────────────────────────
# The Next.js route.ts proxy forwards requests to this URL.
FASTAPI_URL=http://127.0.0.1:8005

# ── Device Streaming ─────────────────────────────────────────────────
# Host where ws-scrcpy is running (e.g. 192.168.1.36:8000 or 127.0.0.1:8000)
NEXT_PUBLIC_STREAMING_HOST=192.168.1.36:8000
