# ── ADB / Local Device ─────────────────────────────────────────────────
# Run `adb devices` to find the serial of your connected Android device.
# Leave empty to use the sole connected device (adb default).
ADB_DEVICE_SERIAL=
ADB_PATH=adb

# ── TypeSafe AI ────────────────────────────────────────────────────────
# Create a TypeSafe key at https://console.typesafe.ai
TYPESAFE_API_KEY=sk-or-v1-key
TYPESAFE_MODEL=inception/mercury-decide:free
TYPESAFE_DEFAULT_MODEL=inception/mercury-decide:free

# only accepts noul questions - respan/span-01-lite:free
# TYPESAFE_DEFAULT_MODEL=respan/span-01-lite:free

TYPESAFE_BASE_URL=https://openrouter.ai/api

# ── Text Input ─────────────────────────────────────────────────────────
# Faster input acknowledgements with exact local read-back before the next action.
# Set to 'committed' to retain the server-side completion wait for all text input.
TEXT_COMPLETION_MODE=accepted

# ── Ports ──────────────────────────────────────────────────────────────
# The studio (Next.js) binds to localhost only.
STUDIO_PORT=3040
# The FastAPI backend port.
FASTAPI_PORT=8000

# ── Backend URL (for Next.js proxy) ───────────────────────────────────
# The Next.js route.ts proxy forwards requests to this URL.
FASTAPI_URL=http://127.0.0.1:8000
